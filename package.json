{
  "name": "my-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/my-app-common",
      "packages/my-app-tools",
      "packages/my-app-react",
      "packages/my-app-backend",
      "packages/my-app-react-web",
      "packages/my-app-express",
      "packages/my-app-tasks",
      "packages/my-app-discord-bot",
      "packages/my-app-react-native"
    ]
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:ordered": "npm --workspace packages/my-app-common run build && npm --workspace packages/my-app-tools run build && npm --workspace packages/my-app-react run build && npm --workspace packages/my-app-backend run build && npm --workspace packages/my-app-react-web run build && npm --workspace packages/my-app-express run build && npm --workspace packages/my-app-tasks run build && npm --workspace packages/my-app-discord-bot run build && npm --workspace packages/my-app-react-native run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "dependencies": {
    "discord.js": "^14.26.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "engines": {
    "node": "v24.14.0",
    "npm": "11.9.0"
  }
}
