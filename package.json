{
  "name": "my-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/my-app-common",
      "packages/my-app-tools",
      "packages/my-app-react",
      "packages/my-app-backend",
      "packages/my-app-react-components",
      "packages/my-app-react-web",
      "packages/my-app-express",
      "packages/my-app-tasks",
      "packages/my-app-discord-bot",
      "packages/my-app-react-native"
    ]
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:ordered": "npm --workspace packages/my-app-common run build && npm --workspace packages/my-app-tools run build && npm --workspace packages/my-app-react run build && npm --workspace packages/my-app-backend run build && npm --workspace packages/my-app-react-web run build && npm --workspace packages/my-app-express run build && npm --workspace packages/my-app-tasks run build && npm --workspace packages/my-app-discord-bot run build && npm --workspace packages/my-app-react-native run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "format": "prettier --write .",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/react-native-web-vite": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-plugin-storybook": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "react-native-web": "^0.21.2",
    "storybook": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^3.1.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/slider": "^5.2.0",
    "@storybook/addon-ondevice-actions": "^10.4.4",
    "@storybook/addon-ondevice-controls": "^10.4.4",
    "@storybook/react-native": "^10.4.4",
    "@storybook/react-native-ui-lite": "^10.4.4",
    "babel-loader": "^10.1.1",
    "discord.js": "^14.26.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-native": "^0.85.3",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.8.3",
    "storybook": "^10.4.1",
    "styled-components": "^7.0.0-prerelease-20260519035351"
  },
  "engines": {
    "node": "v24.14.0",
    "npm": "11.9.0"
  }
}
