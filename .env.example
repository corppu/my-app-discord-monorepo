# my-app Environment Variables Example
# Copy this file to .env and fill in the actual values
# Run `npm run setup-env` for guided interactive setup

# Application environment
NODE_ENV=development

# PostgreSQL Configuration
DATABASE_URL=postgresql://myapp:myapp_password@localhost:5432/myapp_db
POSTGRES_USER=myapp
POSTGRES_PASSWORD=myapp_password
POSTGRES_DB=myapp_db
POSTGRES_PORT=5432

# Discord Configuration
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_GUILD_IDS=123456789012345678,987654321098765432

# Express Server
EXPRESS_PORT=3000

# OpenID Connect Configuration
OPENID_ISSUER_URL=https://accounts.google.com
OPENID_CLIENT_ID=your-client-id-here
OPENID_CLIENT_SECRET=your-client-secret-here
OPENID_REDIRECT_URI=http://localhost:3000/api/auth/callback

# JWT / Session Secrets (minimum 32 characters)
JWT_SECRET=your-jwt-secret-minimum-32-characters-long
SESSION_SECRET=your-session-secret-minimum-32-chars

# React Web App
VITE_API_URL=http://localhost:3000
WEB_PORT=8080

# React Native App
MY_APP_API_URL=http://localhost:3000
MY_APP_WEB_URL=http://localhost:8080

# Tasks Configuration
CLEANUP_INTERVAL_MS=3600000
